{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./out/test",
    "rootDir": "./src/test",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "vscode"]
  },
  "include": ["src/test/e2e/**/*.ts", "src/test/ui/helpers/workspaceHelper.ts"],
  "exclude": ["node_modules"]
}
